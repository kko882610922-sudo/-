    { id: 'fire', name: '리자드', stage: 2, typeName: '불/불', imageUrl: 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/5.png', icon: '🔥🔥', color: 'bg-red-600', text: 'text-red-600', beats: 'grass', dmg: 22 },
